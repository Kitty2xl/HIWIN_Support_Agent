# Backend config, generated from pipeline/settings.json by env_from_settings.py.
# Re-run that script whenever you change the shared DB / image / server values.

# --- Inference server (llama.cpp router, OpenAI-compatible endpoint) ---
INFERENCE_HOST=http://localhost:11400
LANGUAGE_MODEL=Support_Agent_Qwen3.6
EMBEDDING_MODEL=Embedding_Qwen3.6
RERANKER_MODEL=Reranker_Qwen3.6

# --- Postgres (must match what the pipeline wrote) ---
DB_NAME=hiwin_rag_db
DB_USER=postgres
DB_PASSWORD=rootpassword
DB_HOST=localhost
DB_PORT=5432
DB_SCHEMA=hiwin_rag
DB_SSLMODE=prefer

# --- Images (same folder the pipeline copies figures into) ---
IMAGE_STATIC_ROOT=/path/to/open_webui/static/HIWIN

# --- Chat logging ---
CHAT_LOG_ENABLED=true
COMPLETENESS_MODE=pre_draft
KEEP_RECENT_TOOL_RESULTS=-1
GRADING_ENABLED=false
COMPLETENESS_PASS_ENABLED=true
CHAT_TIMEOUT=30000
COMPLETENESS_MODEL=Support_Agent_Aux
COMPLETENESS_CONCURRENCY=4
# Measured: 20 candidates x 2000 chars = ~9.7k tokens per rerank call, which is
# what makes reranking cost ~15s on a partially-offloaded model. Halving the
# per-doc budget halves that prefill; the ranking signal is almost always in the
# opening of a passage. Full passages still go to the LLM either way.
RERANK_DOC_MAX_CHARS=1000
